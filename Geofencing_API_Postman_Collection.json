    },
    {
      "name": "Reports & History",
      "item": [
        {
          "name": "Attendance History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authtoken",
                "value": "{{authtoken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/geofencing/attendance_history?date_from={{$isoTimestamp}}&date_to={{$isoTimestamp}}&limit=10&offset=0",
              "host": ["{{base_url}}"],
              "path": ["api", "geofencing", "attendance_history"],
              "query": [
                {
                  "key": "date_from",
                  "value": "{{$isoTimestamp}}",
                  "description": "Start date (YYYY-MM-DD)"
                },
                {
                  "key": "date_to",
                  "value": "{{$isoTimestamp}}",
                  "description": "End date (YYYY-MM-DD)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of records to return"
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Pagination offset"
                }
              ]
            },
            "description": "Get attendance history with pagination"
          }
        },
        {
          "name": "Daily Report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authtoken",
                "value": "{{authtoken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/geofencing/daily_report?date={{$isoTimestamp}}",
              "host": ["{{base_url}}"],
              "path": ["api", "geofencing", "daily_report"],
              "query": [
                {
                  "key": "date",
                  "value": "{{$isoTimestamp}}",
                  "description": "Report date (YYYY-MM-DD)"
                }
              ]
            },
            "description": "Get detailed daily attendance report"
          }
        },
        {
          "name": "Weekly Report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authtoken",
                "value": "{{authtoken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/geofencing/weekly_report?week_start=2024-10-14",
              "host": ["{{base_url}}"],
              "path": ["api", "geofencing", "weekly_report"],
              "query": [
                {
                  "key": "week_start",
                  "value": "2024-10-14",
                  "description": "Week start date (YYYY-MM-DD, Monday)"
                }
              ]
            },
            "description": "Get weekly attendance summary"
          }
        },
        {
          "name": "Monthly Report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authtoken",
                "value": "{{authtoken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/geofencing/monthly_report?month=2024-10",
              "host": ["{{base_url}}"],
              "path": ["api", "geofencing", "monthly_report"],
              "query": [
                {
                  "key": "month",
                  "value": "2024-10",
                  "description": "Report month (YYYY-MM)"
                }
              ]
            },
            "description": "Get monthly attendance statistics"
          }
        }
      ],
      "description": "Attendance reports and historical data"
    },
    {
      "name": "Testing & Debugging",
      "item": [
        {
          "name": "Test Authentication Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response status is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Authentication is working', () => {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('status');",
                  "    if (response.status === false && response.message && response.message.includes('Token')) {",
                  "        pm.test.skip('Authentication token required');",
                  "    } else {",
                  "        pm.expect(response.status).to.be.true;",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authtoken",
                "value": "{{authtoken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/geofencing/status",
              "host": ["{{base_url}}"],
              "path": ["api", "geofencing", "status"]
            },
            "description": "Quick test to verify authentication is working"
          }
        },
        {
          "name": "API Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api_settings",
              "host": ["{{base_url}}"],
              "path": ["api_settings"]
            },
            "description": "Check if API endpoints are accessible"
          }
        }
      ],
      "description": "Testing and debugging utilities"
    }
  ]
}
