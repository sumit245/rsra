{
  "info": {
    "name": "Geofencing Attendance API",
    "description": "Complete API collection for testing geofencing-based attendance management system",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authtoken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-set base URL if not defined",
          "if (!pm.environment.get('base_url')) {",
          "    pm.environment.set('base_url', 'http://localhost/rsra/index.php');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/rsra/index.php",
      "type": "string"
    },
    {
      "key": "authtoken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Extract and save auth token",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.status && response.data && response.data.authtoken) {",
                  "        pm.environment.set('authtoken', response.data.authtoken);",
                  "        pm.test('Login successful', () => {",
                  "            pm.expect(response.status).to.be.true;",
                  "        });",
                  "        pm.test('Auth token received', () => {",
                  "            pm.expect(response.data.authtoken).to.be.a('string');",
                  "        });",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "sumitranjan245@gmail.com",
                  "description": "User email address"
                },
                {
                  "key": "password",
                  "value": "123456",
                  "description": "User password"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticate user and get JWT token for API access"
          }
        }
      ],
      "description": "Authentication endpoints for getting access tokens"
    },
    {
      "name": "Device Management",
      "item": [
        {
          "name": "Register Device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authtoken",
                "value": "{{authtoken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "device_id",
                  "value": "device-{{$randomUUID}}",
                  "description": "Unique device identifier"
                },
                {
                  "key": "device_name",
                  "value": "Test Android Device",
                  "description": "Human readable device name"
                },
                {
                  "key": "device_type",
                  "value": "android",
                  "description": "Device type: android, ios, web"
                },
                {
                  "key": "device_model",
                  "value": "Samsung Galaxy S21",
                  "description": "Device model information"
                },
                {
                  "key": "os_version",
                  "value": "13.0",
                  "description": "Operating system version"
                },
                {
                  "key": "app_version",
                  "value": "1.0.0",
                  "description": "Mobile app version"
                },
                {
                  "key": "push_token",
                  "value": "push-token-{{$randomAlphaNumeric}}",
                  "description": "Push notification token"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/geofencing/register_device",
              "host": ["{{base_url}}"],
              "path": ["api", "geofencing", "register_device"]
            },
            "description": "Register mobile device for geofencing attendance"
          }
        }
      ],
      "description": "Device registration and management"
    },
    {
      "name": "Geofences",
      "item": [
        {
          "name": "Get Assigned Geofences",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authtoken",
                "value": "{{authtoken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/geofencing/geofences",
              "host": ["{{base_url}}"],
              "path": ["api", "geofencing", "geofences"]
            },
            "description": "Get list of geofences assigned to current user"
          }
        },
        {
          "name": "Get Nearby Geofences",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authtoken",
                "value": "{{authtoken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/geofencing/geofences/nearby?lat=28.6139&lng=77.2090&radius=5",
              "host": ["{{base_url}}"],
              "path": ["api", "geofencing", "geofences", "nearby"],
              "query": [
                {
                  "key": "lat",
                  "value": "28.6139",
                  "description": "Current latitude"
                },
                {
                  "key": "lng",
                  "value": "77.2090",
                  "description": "Current longitude"
                },
                {
                  "key": "radius",
                  "value": "5",
                  "description": "Search radius in kilometers"
                }
              ]
            },
            "description": "Find geofences near current location"
          }
        },
        {
          "name": "Check Location in Geofence",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authtoken",
                "value": "{{authtoken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "latitude",
                  "value": "28.6139",
                  "description": "Current latitude"
                },
                {
                  "key": "longitude",
                  "value": "77.2090",
                  "description": "Current longitude"
                },
                {
                  "key": "accuracy",
                  "value": "10",
                  "description": "GPS accuracy in meters"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/geofencing/check_location",
              "host": ["{{base_url}}"],
              "path": ["api", "geofencing", "check_location"]
            },
            "description": "Check if current location is within any assigned geofence"
          }
        }
      ],
      "description": "Geofence location and validation endpoints"
    },
