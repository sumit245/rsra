                  "description": "GPS accuracy in meters"
                },
                {
                  "key": "notes",
                  "value": "Completed work for today",
                  "description": "Check-out notes (optional)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/geofencing/checkout",
              "host": ["{{base_url}}"],
