            },
            "description": "Check-out to end attendance session"
          }
        },
        {
          "name": "Update Location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authtoken",
                "value": "{{authtoken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "latitude",
                  "value": "28.6141",
                  "description": "Current latitude"
                },
                {
                  "key": "longitude",
                  "value": "77.2092",
                  "description": "Current longitude"
                },
                {
                  "key": "accuracy",
                  "value": "15",
                  "description": "GPS accuracy in meters"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/geofencing/update_location",
              "host": ["{{base_url}}"],
              "path": ["api", "geofencing", "update_location"]
            },
            "description": "Update current location during active session"
          }
        },
        {
          "name": "Get Current Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "authtoken",
                "value": "{{authtoken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/geofencing/status",
              "host": ["{{base_url}}"],
              "path": ["api", "geofencing", "status"]
            },
            "description": "Get current attendance status and active session information"
          }
        }
      ],
      "description": "Core attendance check-in/check-out operations"
    },
    {
      "name": "Break Management",
      "item": [
        {
          "name": "Start Break",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authtoken",
                "value": "{{authtoken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "break_type",
                  "value": "lunch",
                  "description": "Type of break: lunch, regular, emergency"
                },
                {
                  "key": "notes",
                  "value": "Going for lunch break",
                  "description": "Break notes (optional)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/geofencing/start_break",
              "host": ["{{base_url}}"],
              "path": ["api", "geofencing", "start_break"]
            },
            "description": "Start a break session during active attendance"
          }
        },
        {
          "name": "End Break",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "authtoken",
                "value": "{{authtoken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": []
            },
            "url": {
              "raw": "{{base_url}}/api/geofencing/end_break",
              "host": ["{{base_url}}"],
              "path": ["api", "geofencing", "end_break"]
            },
