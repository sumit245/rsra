	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-set base URL if not configured",
					"if (!pm.environment.get('base_url')) {",
					"    pm.environment.set('base_url', 'http://localhost/rsra/index.php');",
					"    console.log('🔧 Base URL set to default: http://localhost/rsra/index.php');",
					"}",
					"",
					"// Check if token exists for authenticated requests",
					"const authRequired = ['leads', 'clients', 'projects', 'tickets', 'auth/profile'];",
					"const currentUrl = pm.request.url.toString();",
					"const requiresAuth = authRequired.some(endpoint => currentUrl.includes(endpoint));",
					"",
					"if (requiresAuth && !pm.environment.get('jwt_token')) {",
					"    console.log('⚠️ Warning: This request requires authentication token');",
					"    console.log('💡 Please run the Login request first');",
					"}"
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost/rsra/index.php",
			"type": "string"
		}
	]
}
